// ─── RiverGuard Prisma Schema ─────────────────────────────────────────────────
// Describes a floating basket + HC-SR04 ultrasonic distance sensor system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Device ────────────────────────────────────────────────────────────────────
// Represents a physical collection basket + sensor unit.
// In the initial demo there is exactly one logical device.
model Device {
  id           String   @id @default(cuid())
  name         String
  identifier   String   @unique   // e.g. "RGRD-001"
  status       DeviceConnectionStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  readings     SensorReading[]
  collections  CollectionEvent[]
  settings     DeviceSettings?

  @@map("devices")
}

enum DeviceConnectionStatus {
  ONLINE
  OFFLINE
  SIMULATED
}

// ── SensorReading ─────────────────────────────────────────────────────────────
// One HC-SR04 distance measurement and derived fill percentage.
model SensorReading {
  id          String      @id @default(cuid())
  deviceId    String
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  distanceCm  Float       // Raw echo-time-derived distance in centimetres
  fillPercent Float       // Derived: ((depth - distance) / depth) * 100, clamped 0–100
  dataSource  DataSource  @default(SIMULATED)
  recordedAt  DateTime    @default(now())

  @@index([deviceId])
  @@index([recordedAt])
  @@map("sensor_readings")
}

// ── CollectionEvent ───────────────────────────────────────────────────────────
// Records each time the basket is emptied (physically or in demo mode).
model CollectionEvent {
  id                     String     @id @default(cuid())
  deviceId               String
  device                 Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fillPercentAtCollection Float
  notes                  String?
  eventType              EventType  @default(DEMO)
  recordedAt             DateTime   @default(now())

  @@index([deviceId])
  @@index([recordedAt])
  @@map("collection_events")
}

enum EventType {
  REAL        // Physical collection confirmed by an operator
  DEMO        // Simulated collection recorded via the dashboard
}

// ── DeviceSettings ────────────────────────────────────────────────────────────
// Application-level thresholds and calibration values per device.
model DeviceSettings {
  id                   String   @id @default(cuid())
  deviceId             String   @unique
  device               Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  basketDepthCm        Float    @default(20)   // Calibrated empty-basket sensor distance
  nearFullThresholdPct Float    @default(80)   // Percentage at which near-full warning fires
  fullThresholdPct     Float    @default(95)   // Percentage at which full alert fires
  pollingIntervalSec   Int      @default(5)    // Target polling frequency
  updatedAt            DateTime @updatedAt

  @@map("device_settings")
}

enum DataSource {
  REAL        // Genuine HC-SR04 reading via Arduino serial
  SIMULATED   // Generated by the demo mode
}
