# ─── RiverGuard Backend — Environment Configuration ──────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (local): postgresql://riverguard:secret@localhost:5432/riverguard_db?schema=public
# Example (Supabase / Neon / Railway): see your provider's connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/riverguard_db?schema=public

# ── CORS ──────────────────────────────────────────────────────────────────────
# The origin of the React frontend (no trailing slash).
FRONTEND_URL=http://localhost:5173

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" in development to allow endpoints that generate demo/simulated data.
# Set to "false" in production.
DEMO_MODE=true
